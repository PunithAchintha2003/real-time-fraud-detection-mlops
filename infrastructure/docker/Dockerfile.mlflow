FROM ghcr.io/mlflow/mlflow:v3.14.0-full

RUN pip install --no-cache-dir \
    azure-storage-blob==12.28.0 \
    psycopg2-binary==2.9.10

EXPOSE 5000

CMD ["sh", "-c", "mlflow db upgrade \"$MLFLOW_BACKEND_STORE_URI\" && exec mlflow server --host 0.0.0.0 --port 5000 --backend-store-uri \"$MLFLOW_BACKEND_STORE_URI\" --artifacts-destination \"$MLFLOW_ARTIFACTS_DESTINATION\""]
